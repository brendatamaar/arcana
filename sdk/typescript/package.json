{
  "name": "@brendatamaar/arcana",
  "packageManager": "pnpm@10.34.9",
  "version": "0.3.0",
  "description": "TypeScript client for the Arcana self-hosted sandbox orchestrator",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "generate": "openapi-typescript ../../api/openapi.yaml -o src/schema.d.ts",
    "verify-generated": "pnpm run generate && git diff --exit-code -- src/schema.d.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\"",
    "test:live": "tsc -p tsconfig.test.json && ARCANA_LIVE=1 node --test dist-test/test/live.test.js"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/ws": "^8.18.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
